# ============================================================
# Armarius Arcanorum (Workflow Archive) 共享环境配置模板
# 复制为 .env 后按部署环境修改(.env 已被 gitignore 忽略)
# 读取方:NestJS Gateway(@nestjs/config) / Python worker(config.py)
#           / run_armarius.* (及兼容 run_workflow_db.*)
# 提示:支持 ARMARIUS_* 与旧版 WORKFLOW_DB_* 双前缀兼容读取
# 注意:值中不要使用未加引号的空格;路径建议放在平台覆盖文件中配置
# ============================================================

# ---------- 服务端口 ----------
# NestJS Gateway 端口
ARMARIUS_PORT=8009
# 启动脚本在网关就绪后自动用默认浏览器打开工具页;0 关闭(兼容 WORKFLOW_DB_AUTO_OPEN)
ARMARIUS_AUTO_OPEN=1

# ---------- 监听地址 / 鉴权 ----------
# 网关监听地址;默认 127.0.0.1 仅本机可访问。多网关/局域网访问需显式改 0.0.0.0,
# 并强烈建议同时配置下方 AUTH_TOKEN(兼容 WORKFLOW_DB_BIND_HOST)
ARMARIUS_BIND_HOST=127.0.0.1
# 敏感端点鉴权 token(请求头 x-auth-token);留空 = 仅回环来源可访问敏感端点,
# 非回环来源一律 401。局域网/多网关部署时必配(兼容 WORKFLOW_DB_AUTH_TOKEN)
ARMARIUS_AUTH_TOKEN=

# ---------- MongoDB(留空 = 使用 SQLite 单引擎,默认) ----------
# 配置后需在设置页点击"检测连接并切换",通过(连通 + 可新建库)才写入并重启生效
MONGODB_URI=
MONGODB_DB=comfy_workflow_archive
MONGODB_COLLECTION=images
MONGODB_RECIPE_GROUPS_COLLECTION=recipe_groups
MONGODB_STATS_DOC_CACHE_COLLECTION=stats_docs
MONGODB_STATS_SUMMARY_CACHE_COLLECTION=stats_summaries

# ---------- 图片扫描根目录 ----------
# Windows 覆盖文件: .env.windows (如 D:/erxx)
# WSL/Linux 覆盖文件: .env.wsl (如 /mnt/d/erxx)
COMFY_SCAN_ROOT=

# 若同一工作区同时被 Windows 与 WSL 使用,分别复制对应的
# .env.windows.example / .env.wsl.example 为 .env.windows / .env.wsl。

# ---------- ComfyUI ----------
COMFYUI_BASE_URL=http://127.0.0.1:8188

# ---------- 同步 / 备份 ----------
# 后台扫描周期(秒),全量 diff 兜底
ARMARIUS_SYNC_INTERVAL_SECONDS=300
# 空库友好:启动即触发一次同步,0 关闭
ARMARIUS_INITIAL_SYNC=1
# 备份目录;留空则备份循环整体停用(兼容 WORKFLOW_DB_BACKUP_DIR)
ARMARIUS_BACKUP_DIR=
# 快照间隔(天)
ARMARIUS_BACKUP_INTERVAL_DAYS=7

# ---------- 近实时通道(内存缓冲 + 批量 diff 入库) ----------
# 轮询 ComfyUI /history 间隔(秒),发现新完成生成即入缓冲;0 关闭
ARMARIUS_COMFY_POLL_SECONDS=3
# 缓冲批量入库间隔(秒)
ARMARIUS_FLUSH_SECONDS=15
# ComfyUI 输出目录(可选)。留空自动探测:
#   从 /history 最近图片在 [scanRoot/today, scanRoot, ~/ComfyUI/output] 中反推;
#   输出已落入扫描根(如 output -> scanRoot/today 软链接)时无需配置。
COMFY_OUTPUT_DIR=
# Windows 原生下启用递归 fs.watch;非 Windows 平台自动降级(0 关闭)
ARMARIUS_FS_WATCH=1

# ---------- 部署根目录 / Python worker ----------
# 显式指定部署根目录(通常可留空,自动探测 workflow_db/__init__.py)
ARMARIUS_ROOT=
# Python 解释器;留空自动解析 <deploy_root>/venv/Scripts/python.exe(Windows)
# 或 <deploy_root>/venv/bin/python(WSL)
WORKER_PYTHON_BIN=
# worker 工作目录;留空 = 部署根目录
WORKER_CWD=
# worker ready 握手超时(ms)
WORKER_SPAWN_TIMEOUT_MS=10000
# 连续失败重启上限
WORKER_MAX_RESTARTS=3

# ---------- 多网关共享库 + 纯远程 ----------
# 纯远程模式:1=不建本地 SQLite、不扫描本地目录,仅连接远端 MongoDB。
# 首次启动未配 MONGODB_URI 时为"待配库"空状态(读端点返回空集,设置页引导)。
# 多网关拓扑:每用户机器各跑一个实例,共享同一远端 MONGODB_URI。
ARMARIUS_REMOTE=0
# 本实例唯一标识(入库逐图片打标 source.instance_id);留空默认主机名
ARMARIUS_INSTANCE_ID=
# 本网关对外可达地址(如 http://192.168.1.10:8009)。
# 纯远程图片透传按记录中 source.base_url 定位持有网关;留空则该实例不参与透传
ARMARIUS_BASE_URL=
# 图片代理白名单(逗号分隔)
ARMARIUS_PROXY_ALLOW_HOSTS=

# ---------- SQLite 灰测轨道(双端并行观察,不影响生产读写) ----------
# SQLite 主库路径;留空默认 <用户数据目录>/gray_workflow.sqlite3
# (Windows %LOCALAPPDATA%\armarius_arcanorum;Linux ~/.local/share/armarius_arcanorum;兼容旧版 workflow_db)
# 建议放在 WSL 原生 ext4(如 /tmp 或 home),避免 9p/drvfs 挂载盘写放大
# 使用:nest_gateway/src/scripts/sqlite-backfill.ts(镜像)/
#       sqlite-gray-compare.ts(双端对照),均支持 --sqlite 覆盖
SQLITE_DB_PATH=
# 双写过渡开关(主用化阶段 1):写路径同时落 Mongo 与 SQLite
SQLITE_DUAL_WRITE=0
# 单引擎开关:SQLITE_READ=1 时读+写全部走 SQLite(启动不依赖 Mongo、写路径
# 跳过 Mongo);不存在的库会在首次启动时自动创建。
# MONGODB_URI 留空时自动启用单引擎(默认);设置页"检测连接并切换"通过后会
# 写入 MONGODB_URI 并将本项置 0
SQLITE_READ=0

# ---------- Danbooru Tag 补全参考(可选组件,默认零配置) ----------
# 全部留空时:发布包含 danbooru/ 资产则自动启用;缺资产则对应能力静默禁用
# (端点返回 enabled:false、ingest 挂钩跳过),不影响既有功能。详见 docs/tag_suggest.md
# 总开关;0 = 联想/相关/补全参考全关
TAG_SUGGEST_ENABLED=1
# GNN 资产目录(vocab_sorted.npy/embed_gnn.npy);留空默认 <repo_root>/danbooru
# DANBOORU_ASSETS=
# 联想/查表库路径;留空默认 <repo_root>/danbooru/danbooru.sqlite3
# DANBOORU_DB_PATH=
