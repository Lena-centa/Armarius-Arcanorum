# Optional native Windows overrides. Copy to repo root as .env.windows.
# Keep only platform-specific paths here; shared settings stay in .env.

# 每平台独立 SQLite 库:双平台共用工作区时建议各自指定库文件,
# 避免 Windows 与 WSL 网关并发访问同一库的 WAL 锁竞争(如 D:/wfdb/gray_workflow.sqlite3)
SQLITE_DB_PATH=
COMFY_SCAN_ROOT=D:/erxx
COMFY_OUTPUT_DIR=
ARMARIUS_BACKUP_DIR=
WORKER_PYTHON_BIN=
WORKER_CWD=
